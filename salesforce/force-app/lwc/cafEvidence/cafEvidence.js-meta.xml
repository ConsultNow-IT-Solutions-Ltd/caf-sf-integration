<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CAF Evidence</masterLabel>
    <description>Upload evidence for a CAF Task to Salesforce Files and to ServiceNow.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>CAF_Task__c</object>
            </objects>
        </targetConfig>
        <!--
            No targetConfig for lightningCommunity__Page: design properties are
            declared under lightningCommunity__Default, and the Page target
            rejects a `property` tag outright rather than ignoring it. The
            target on its own is what makes the component droppable on an
            Experience Cloud page, which is all step 7 needs from it.
        -->
    </targetConfigs>
</LightningComponentBundle>
