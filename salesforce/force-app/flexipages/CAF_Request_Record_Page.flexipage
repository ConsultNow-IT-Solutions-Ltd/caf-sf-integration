<?xml version="1.0" encoding="UTF-8"?>
<!--
    CAF_Request__c record page (CAF-230): highlights across the top, the record
    detail in the main column, and cafTaskTimeline beside it. Each timeline
    entry opens the task record page (CAF-229).

    Assigned as the View override in the CAF Compliance app, like the task
    page; the org-wide default is set in App Builder.
-->
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>force:highlightsPanel</componentName>
                <identifier>force_highlightsPanel</identifier>
            </componentInstance>
        </itemInstances>
        <name>header</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>force:detailPanel</componentName>
                <identifier>force_detailPanel</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>cafTaskTimeline</componentName>
                <identifier>c_cafTaskTimeline</identifier>
            </componentInstance>
        </itemInstances>
        <name>sidebar</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>CAF Request Record Page</masterLabel>
    <sobjectType>CAF_Request__c</sobjectType>
    <template>
        <name>flexipage:recordHomeTemplateDesktop</name>
    </template>
    <type>RecordPage</type>
</FlexiPage>
