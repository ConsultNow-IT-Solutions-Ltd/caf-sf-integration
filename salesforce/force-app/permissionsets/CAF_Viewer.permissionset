<?xml version="1.0" encoding="UTF-8"?>
<!--
    The base for every person using CAF in Salesforce (CAF-221). Read-only:
    the mirrored records, the dashboard, Reports and the task panel. Nobody
    edits a mirror record here - changes go to ServiceNow, which pushes them
    back as the integration user - so no role needs more than read.

    The action classes are included so the panel renders for a viewer; the
    actions themselves check CAF_Work_Tasks / CAF_Attest (CafAccess) and
    refuse with a message naming the permission set to ask for.

    Assign alone, or with CAF_Owner, CAF_Approver or CAF_Admin on top.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <applicationVisibilities>
        <application>CAF_Compliance</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>CafAttestationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CafDashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CafEvidenceService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CafReportsController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CafTaskService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Read-only CAF access: dashboard, reports, requests and tasks. The base the other CAF permission sets layer on.</description>
