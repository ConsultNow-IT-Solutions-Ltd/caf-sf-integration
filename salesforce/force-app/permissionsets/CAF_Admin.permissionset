<?xml version="1.0" encoding="UTF-8"?>
<!--
    Layered on top of CAF_Integration for whoever looks after the integration.
    It adds read access to the callout log and nothing else: the Admin screen
    is read-only, and the log is written by CafCalloutEventTrigger in system
    mode, so no user needs create or edit on it.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>CafAdminController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>CAF administration: read the ServiceNow callout log on the CAF Dashboard Admin screen. Assign alongside CAF Integration.</description>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Called_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Endpoint__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Error__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Latency_Ms__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Method__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Operation__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Requested_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Status_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>CAF_Integration_Log__c.Succeeded__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>CAF Admin</label>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CAF_Integration_Log__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
