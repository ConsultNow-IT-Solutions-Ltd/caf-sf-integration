# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The ServiceNow UI login. This is a *user* credential for driving the browser,
# and is deliberately NOT the same thing as:
#   - the cnit OAuth token (DPAPI-encrypted, cnit's own business)
#   - the sf.integration password (an integration account, not a UI user)
#
# The account needs enough rights to see CAF Requests and Tasks in the native UI.
# For role-based cases (TC-SN-061..064) additional accounts get their own vars.

SN_INSTANCE=https://dev281754.service-now.com
SN_USER=
SN_PASSWORD=

# Where cnit.ps1 lives. The toolkit is a private PowerShell folder rather than an
# installed package, so its path differs per machine. Unset falls back to
# C:\audit\cnit-instance-tools-main\cnit.ps1.
CNIT_PS1=

# The sf.integration password, needed only by the inbound API cases
# (specs/integration-negative.spec.ts and the write suites). Those cases
# authenticate as that user because the echo-loop guard keys off it — admin is
# not a substitute, and admin basic auth returns 401 on this instance anyway.
# Set the file path if you have the file, or the password itself if you do not.
SF_INTEGRATION_PASSWORD_FILE=
SF_INTEGRATION_PASSWORD=
